<div class="d-grid gap-3">
  <div class="input-group">
    <span class="input-group-text" style="width: 6em"
      ><strong> Base URL </strong></span
    >
    <span id="base-url" class="form-control"
      ><code id="base-url">
        http://<%= host %>.pax.tufts.edu:<%= port %>
      </code></span
    >
    <button
      class="btn btn-light far fa-copy copy-btn"
      type="button"
      data-target="base-url"
      style="aspect-ratio: 1 / 1"
      title="Copy Base URL"
    ></button>
  </div>
  <div class="input-group">
    <span class="input-group-text" style="width: 6em"
      ><strong> API Key </strong></span
    >
    <span id="api-key" class="form-control"
      ><code id="api-key"> <%= password %></code>
    </span>
    <button
      class="btn btn-light far fa-copy copy-btn"
      type="button"
      data-target="api-key"
      style="aspect-ratio: 1 / 1"
      title="Copy API Key"
    ></button>
  </div>
</div>

<hr />

<!-- blank lines prevent redcarpet from rendering the following as markdown -->

<div class="d-flex gap-2">
  <a
    href="/rnode/<%= host %>/<%= port %>/"
    class="btn btn-primary"
    id="launch-button"
  >
    <i class="fa fa-eye"></i> Launch Web UI
  </a>
  <a
    href="/pun/sys/dashboard/files/fs/<%= output_log %>"
    class="btn btn-secondary"
  >
    <i class="fa fa-file-text"></i> View Server Log
  </a>
</div>

<script>
  document
    .getElementById("launch-button")
    .addEventListener("mouseover", function () {
      localStorage.setItem(
        "LlamaCppWebui.config",
        '{"apiKey":"<%= password %>"}',
      );
    });
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      const targetId = btn.getAttribute("data-target");
      const code = document.getElementById(targetId).innerText;
      navigator.clipboard.writeText(code);
      btn.classList.remove("fa-copy");
      btn.classList.add("fa-check-square");
      setTimeout(() => {
        btn.classList.remove("fa-check-square");
        btn.classList.add("fa-copy");
      }, 1500);
    });
  });
</script>
