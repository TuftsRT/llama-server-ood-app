<div class="d-grid gap-3">
  <div class="input-group">
    <span class="input-group-text" style="width: 6em"
      ><strong> Base URL </strong></span
    >
    <span class="form-control"
      ><samp data-id="base-url"
        >http://<%= host %>.pax.tufts.edu:<%= port %></samp
      ></span
    >
    <button
      class="btn btn-light copy-btn"
      type="button"
      data-target="base-url"
      data-label="Base URL"
      style="aspect-ratio: 1 / 1"
      title="Copy Base URL"
    >
      <i class="far fa-fw fa-copy" aria-hidden="true"></i>
      <span class="visually-hidden">Copy Base URL</span>
    </button>
  </div>
  <div class="input-group">
    <span class="input-group-text" style="width: 6em"
      ><strong> API Key </strong></span
    >
    <span class="form-control"
      ><samp data-id="api-key"><%= password %></samp></span
    >
    <button
      class="btn btn-light copy-btn"
      type="button"
      data-target="api-key"
      data-label="API Key"
      style="aspect-ratio: 1 / 1"
      title="Copy API Key"
    >
      <i class="far fa-fw fa-copy" aria-hidden="true"></i>
      <span class="visually-hidden">Copy API Key</span>
    </button>
  </div>
</div>

<span class="visually-hidden" role="status" data-id="copy-status"></span>

<p class="small text-danger mt-3 mb-0">
  <i class="fa fa-warning" aria-hidden="true"></i>
  API traffic unencrypted. Do not transmit sensitive information.
</p>

<hr />

<!-- blank lines prevent redcarpet from rendering the following as markdown -->

<div class="d-flex gap-2">
  <a href="/rnode/<%= host %>/<%= port %>/" class="btn btn-primary launch-btn">
    <i class="fa fa-eye" aria-hidden="true"></i> Launch Web UI
  </a>
  <a
    href="/pun/sys/dashboard/files/fs/<%= output_log %>"
    class="btn btn-secondary"
  >
    <i class="fa fa-file-text" aria-hidden="true"></i> View Server Log
  </a>
</div>

<p class="small text-muted mt-2 mb-0">
  <i class="fa fa-info-circle" aria-hidden="true"></i>
  Web UI stores chat history, uploads, settings, and API key in the browser.
</p>

<script>
  (() => {
    const scope = document.currentScript.parentElement;
    const launchBtn = scope.querySelector(".launch-btn");
    const storeApiKey = function () {
      let config = {};
      try {
        config = JSON.parse(localStorage.getItem("LlamaUi.config") || "{}");
      } catch {
        config = {};
      }
      config.apiKey = "<%= password %>";
      localStorage.setItem("LlamaUi.config", JSON.stringify(config));
    };
    launchBtn.addEventListener("click", storeApiKey);
    launchBtn.addEventListener("mousedown", storeApiKey);
    launchBtn.addEventListener("touchstart", storeApiKey);
    const status = scope.querySelector('[data-id="copy-status"]');
    scope.querySelectorAll(".copy-btn").forEach((btn) => {
      const icon = btn.querySelector("i");
      const name = btn.getAttribute("data-label");
      let timer;
      const flash = function (iconClass, message) {
        clearTimeout(timer);
        icon.className = `far fa-fw ${iconClass}`;
        status.textContent = message;
        timer = setTimeout(() => {
          icon.className = "far fa-fw fa-copy";
          if (status.textContent === message) status.textContent = "";
        }, 1500);
      };
      btn.addEventListener("click", async function () {
        const targetId = btn.getAttribute("data-target");
        try {
          const code = scope
            .querySelector(`[data-id="${targetId}"]`)
            .textContent.trim();
          await navigator.clipboard.writeText(code);
          flash("fa-check-square", `Copied ${name}`);
        } catch {
          flash("fa-times-circle", `Could not copy ${name}`);
        }
      });
    });
  })();
</script>
