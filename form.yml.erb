# <% require "json" %>
# <% require "securerandom" %>
---
cluster: "pax"

# <% read_local = ->(path) { File.read(File.join(__dir__, path)) } %>

form_header: |
<%= read_local.call("partials/acceptable-use.html").rstrip.indent(2) %>
<%= read_local.call("partials/ai-disclaimer.html").rstrip.indent(2) %>
<%= read_local.call("partials/data-retention.html").rstrip.indent(2) %>
  <h4>Job Configuration</h4>

form:
  - "num_hours"
  - "use_preset"
  - "resource_preset"
  - "preset_multiplier"
  - "num_cores"
  - "memory_ram"
  - "gpu_preference"
  - "min_vram"
  - "exact_vram"
  - "gpu_model"
  - "num_gpu"
  - "allow_preempt"
  - "use_router"
  - "use_default_models"
  - "models_dir"
  - "models_ini"
  - "use_custom_model"
  - "model_selection"
  - "model_file"
  - "mmproj_file"
  - "use_random_key"
  - "api_key"

# <% max_hours = 48 %>

attributes:
  num_hours:
    widget: "number_field"
    label: "Hours"
    cacheable: false
    required: true
    help: |
      Upper limit for the job runtime in hours.
      Jobs exceeding this limit will be terminated.
      Higher values might delay job start.
      Maximum allowed runtime is <%= max_hours %> hours.
    value: 1
    min: 1
    max: <%= max_hours %>
    step: 1

  use_preset:
    widget: "select"
    label: "Resource Preference"
    cacheable: false
    help: |
      Ensure the selected configuration is possible if not using presets.
      Consult the [system status dashboard](/pun/sys/dashboard/system-status)
      for node configuration details and current resource availability.
    value: "1"
    options:
      - [
          "Use Resource Presets (Recommended)",
          "1",
          {
            data-hide-allow-preempt: true,
            data-hide-exact-vram: true,
            data-hide-gpu-model: true,
            data-hide-gpu-preference: true,
            data-hide-memory-ram: true,
            data-hide-min-vram: true,
            data-hide-num-cores: true,
            data-hide-num-gpu: true,
          },
        ]
      - [
          "Manually Specify Configuration (Advanced)",
          "0",
          {
            data-hide-exact-vram: true,
            data-hide-gpu-model: true,
            data-hide-min-vram: true,
            data-hide-num-gpu: true,
            data-hide-preset-multiplier: true,
            data-hide-resource-preset: true,
            data-set-gpu-preference: "none",
          },
        ]

  resource_preset:
    widget: "select"
    label: "Resource Preset"
    cacheable: false
    help: |
      Choose a preset that accommodates the model you are planning on using.
      Models that can completely fit into VRAM will have optimal performance.
      Models that exceed the combined total of RAM and VRAM cannot be used.
      Preset values can be multiplied below if more resources are needed.
      Jobs that request more resources take longer to start.
    value: "a100-40G/94/4"
    options:
      - [
          "A100 GPU / 40 GB VRAM / 94 GB RAM / 4 CPU",
          "a100-40G/94/4",
          { data-max-preset-multiplier: 8 },
        ]
      - [
          "L40S GPU / 48 GB VRAM / 125 GB RAM / 16 CPU",
          "l40s-48G/125/16",
          { data-max-preset-multiplier: 4 },
        ]
      - [
          "A100 GPU / 80 GB VRAM / 125 GB RAM / 8 CPU",
          "a100-80G/125/8",
          { data-max-preset-multiplier: 8 },
        ]
      - [
          "H200 GPU / 141 GB VRAM / 187 GB RAM / 12 CPU",
          "h200-141G/187/12",
          { data-max-preset-multiplier: 8 },
        ]

  preset_multiplier:
    widget: "number_field"
    label: "Preset Multiplier"
    cacheable: false
    required: true
    help: |
      Multiplies the resources of the selected preset by this value.
      For example, the preset "A100 GPU / 40 GB VRAM / 94 GB RAM / 4 CPU"
      with a multiplier of two (2) results in two A100 GPUs, 80 GB VRAM,
      188 GB RAM, and 8 CPU cores. The maximum allowed multiplier is four (4)
      for the L40S preset and eight (8) for all other presets.
    value: 1
    min: 1
    max: 8
    step: 1

  num_cores:
    widget: "select"
    label: "CPU Cores"
    cacheable: false
    required: true
    help: "Higher values increase performance but might delay job start."
    value: "4"
    options:
      - "4"
      - "8"
      - "12"
      - "16"
      - "24"
      - "32"
      - "48"
      - "64"
      - "96"

  memory_ram:
    widget: "select"
    label: "Memory (RAM)"
    cacheable: false
    help: |
      RAM is used when no GPU is selected or when the whole model cannot fit
      into VRAM. Higher values increase performance but might delay job start.
    value: "8g"
    options:
      - ["8 GB", "8g"]
      - ["16 GB", "16g"]
      - ["32 GB", "32g"]
      - ["64 GB", "64g"]
      - ["96 GB", "96g"]
      - ["128 GB", "128g"]
      - ["192 GB", "192g"]
      - ["256 GB", "256g"]
      - ["384 GB", "384g"]
      - ["512 GB", "512g"]
      - ["768 GB", "768g"]
      - ["1024 GB", "1024g"]
      - ["1536 GB", "1536g"]

  gpu_preference:
    widget: "select"
    label: "GPU Preference"
    cacheable: false
    help: |
      Not selecting a GPU decreases performance but might allow your job to
      start sooner. Optimal performance requires total VRAM that can fit the
      entire model and batch size.
    value: "none"
    options:
      - [
          "No GPU (No VRAM)",
          "none",
          {
            data-hide-exact-vram: true,
            data-hide-gpu-model: true,
            data-hide-min-vram: true,
            data-hide-num-gpu: true,
          },
        ]
      - [
          "Any GPU (≥ 16 GB VRAM)",
          "any",
          {
            data-hide-exact-vram: true,
            data-hide-gpu-model: true,
            data-hide-min-vram: true,
          },
        ]
      - [
          "Minimum VRAM Requirement",
          "min-vram",
          { data-hide-exact-vram: true, data-hide-gpu-model: true },
        ]
      - [
          "Exact VRAM Requirement",
          "exact-vram",
          { data-hide-gpu-model: true, data-hide-min-vram: true },
        ]
      - [
          "Choose Specific GPU Model",
          "gpu-model",
          { data-hide-exact-vram: true, data-hide-min-vram: true },
        ]

  # <% load File.join(__dir__, "lib/gpu_config.rb") %>

  min_vram:
    widget: "select"
    label: "Minimum VRAM"
    cacheable: false
    help: |
      Automatically select a GPU with VRAM equaling or exceeding the
      selected option. Higher values might delay job start.
    value: "<%= min_vram_options.first.last %>"
    options: <%= JSON.generate(min_vram_options) %>

  exact_vram:
    widget: "select"
    label: "Exact VRAM"
    cacheable: false
    help: |
      Automatically select a GPU with exactly the selected VRAM.
      Subject to GPU availability.
    value: "<%= exact_vram_options.first.last %>"
    options: <%= JSON.generate(exact_vram_options) %>

  gpu_model:
    widget: "select"
    label: "GPU Model (VRAM)"
    cacheable: false
    help: |
      Only use if a specific GPU model is required.
      Might delay job start due to GPU availability.
    value: "<%= gpu_model_options.first.last %>"
    options: <%= JSON.generate(gpu_model_options) %>

  num_gpu:
    widget: "number_field"
    label: "Number of GPUs"
    cacheable: false
    required: true
    help: |
      Number of the selected GPU to request. Total VRAM equals the selected
      VRAM multiplied by this number. Higher values might delay job start.
      Up to 8 GPUs possible.
    value: 1
    min: 1
    max: 8
    step: 1

  allow_preempt:
    widget: "check_box"
    label: "Allow Preemption"
    cacheable: false
    help: |
      Gain access to reserved resources and potentially start the job sooner
      by allowing your job to be preempted (terminated without warning) if
      higher-priority jobs need resources.

  # <% load File.join(__dir__, "lib/model_discovery.rb") %>
  # <% models_dir = "/cluster/tufts/datasets/ai/models/gguf" %>
  # <% models = discover_models(models_dir) %>
  # <% default_model = models.find_by_label("Qwen3.6-27B-UD-Q8_K_XL") %>

  use_router:
    widget: "select"
    label: "Server Mode"
    value: "0"
    help: |
      Router mode is *experimental* and allows for the dynamic loading and
      unloading of multiple models from a specified directory. Classic mode
      preloads a single specified model that cannot be changed without
      cancelling the job and submitting a new one.
    options:
      - [
          "Classic (Single-Model)",
          "0",
          {
            data-hide-mmproj-file: true,
            data-hide-model-file: true,
            data-hide-models-dir: true,
            data-hide-models-ini: true,
            data-hide-use-default-models: true,
            data-set-models-dir: "<%= models_dir %>",
            data-set-models-ini: "",
            data-set-use-custom-model: "0",
            data-set-use-default-models: "1",
          },
        ]
      - [
          "Router (Multi-Model)",
          "1",
          {
            data-hide-mmproj-file: true,
            data-hide-model-file: true,
            data-hide-model-selection: true,
            data-hide-models-dir: true,
            data-hide-models-ini: true,
            data-hide-use-custom-model: true,
            data-set-mmproj-file: "<%= default_model[:mmproj_path] %>",
            data-set-model-file: "<%= default_model[:model_path] %>",
            data-set-model-selection: "<%= default_model[:model_path] %>",
            data-set-models-dir: "<%= models_dir %>",
            data-set-models-ini: "",
            data-set-use-default-models: "1",
          },
        ]

  use_default_models:
    widget: "select"
    label: "Model Set"
    cacheable: false
    value: "1"
    help: |
      The default set contains a curated selection of pre-downloaded models.
    options:
      - [
          "Default (Recommended)",
          "1",
          {
            data-hide-models-dir: true,
            data-hide-models-ini: true,
            data-set-models-dir: "<%= models_dir %>",
            data-set-models-ini: "",
          },
        ]
      - [
          "Custom (Advanced)",
          "0",
          { data-set-models-dir: "", data-set-models-ini: "" },
        ]

  models_dir:
    widget: "text_field"
    label: "Models Directory"
    cacheable: false
    help: |
      <p style="margin-bottom: 0">
        Path to a directory containing model files in GGUF format. Refer to the
        <a
          href="https://github.com/ggml-org/llama.cpp/tree/master/tools/server#model-sources"
        >
          LLaMA CPP Server documentation
        </a>
        for the expected directory structure and file naming conventions.
      </p>
      <ul>
        <li>
          <code>/cluster/home/<%= ENV['USER'] %>/.../&lt;models-dir&gt;</code>
        </li>
        <li>
          <code>/cluster/tufts/&lt;project&gt;/.../&lt;models-dir&gt;</code>
        </li>
      </ul>
    value: "<%= models_dir %>"
    pattern: |-
      ^/(cluster/(tufts|home)/[A-Za-z0-9_\-\.]+(/[A-Za-z0-9_\-\.]+)*)/?$

  models_ini:
    widget: "text_field"
    label: "Model Presets File"
    cacheable: false
    help: |
      <p style="margin-bottom: 0">
        Path to an INI file defining model presets. Refer to the
        <a
          href="https://github.com/ggml-org/llama.cpp/tree/master/tools/server#model-presets"
        >
          LLaMA CPP Server documentation
        </a>
        for the required file structure, example content, and preset options.
      </p>
      <ul>
        <li>
          <code>/cluster/home/<%= ENV['USER'] %>/.../&lt;presets&gt;.ini</code>
        </li>
        <li>
          <code>/cluster/tufts/&lt;project&gt;/.../&lt;presets&gt;.ini</code>
        </li>
      </ul>
    value: ""
    pattern: |-
      ^/(cluster/(tufts|home)/[A-Za-z0-9_\-\.]+(/[A-Za-z0-9_\-\.]+)*)\.ini$

  use_custom_model:
    widget: "select"
    label: "Model Preference"
    cacheable: false
    value: "0"
    options:
      - [
          "Select Pre-Downloaded Model (Recommended)",
          "0",
          {
            data-hide-mmproj-file: true,
            data-hide-model-file: true,
            data-set-mmproj-file: "<%= default_model[:mmproj_path] %>",
            data-set-model-file: "<%= default_model[:model_path] %>",
            data-set-model-selection: "<%= default_model[:model_path] %>",
          },
        ]
      - [
          "Manually Specify Custom Model File (Advanced)",
          "1",
          {
            data-hide-model-selection: true,
            data-set-mmproj-file: "",
            data-set-model-file: "",
          },
        ]

  model_selection:
    widget: "select"
    label: "Pre-Downloaded Model"
    cacheable: false
    help: |
      Selected VRAM/RAM should exceed the displayed model size by several GB.
    value: "<%= default_model[:model_path] %>"
    options: <%= JSON.generate(models.options) %>

  model_file:
    widget: "text_field"
    label: "Model File"
    cacheable: false
    required: true
    help: |
      <p style="margin-bottom: 0">
        Path to a model file in GGUF format. For sharded models, specify the
        path to the first file (ending in <code>00001-of-?????.gguf</code>)
        and ensure all related files are in the same directory.
      </p>
      <ul>
        <li>
          <code
            >/cluster/home/<%= ENV['USER']
            %>/.../&lt;model&gt;[-00001-of-?????].gguf</code
          >
        </li>
        <li>
          <code
            >/cluster/tufts/&lt;project&gt;/.../&lt;model&gt;[-00001-of-?????].gguf</code
          >
        </li>
      </ul>
    value: "<%= default_model[:model_path] %>"
    pattern: |-
      ^/(cluster/(tufts|home)/[A-Za-z0-9_\-\.]+(/[A-Za-z0-9_\-\.]+)*)\.gguf$

  mmproj_file:
    widget: "text_field"
    label: "Multi-Modal Projector"
    cacheable: false
    help: |
      <p style="margin-bottom: 0">
        Path to a multi-modal projector (MMProj) file in GGUF format.
        Needed for multi-modal capabilities for supported models and
        usually distributed alongside the model file(s).
      </p>
      <ul>
        <li>
          <code>/cluster/home/<%= ENV['USER'] %>/.../mmproj-&lt;dtype&gt;.gguf</code>
        </li>
        <li>
          <code>/cluster/tufts/&lt;project&gt;/.../mmproj-&lt;dtype&gt;.gguf</code>
        </li>
      </ul>
    value: "<%= default_model[:mmproj_path] %>"
    pattern: |-
      ^/(cluster/(tufts|home))(?:/[A-Za-z0-9_\-\.]+)*/mmproj-[A-Za-z0-9_-]+\.gguf$

  # <% key_len = 32 %>
  # <% api_key = SecureRandom.alphanumeric(key_len) %>

  use_random_key:
    widget: "select"
    label: "API Key Preference"
    cacheable: false
    help: |
      Used to authenticate server requests.
      Will be displayed on the job information card.
    value: "1"
    options:
      - [
          "Randomly Generate (Recommended)",
          "1",
          { data-hide-api-key: true, data-set-api-key: "<%= api_key %>" },
        ]
      - ["Manually Specify API Key (Advanced)", "0", { data-set-api-key: "" }]

  api_key:
    widget: "text_field"
    label: "API Key"
    cacheable: false
    required: true
    help: |
      Must be at least <%= key_len %> characters.
      Only letters and numbers allowed. Case sensitive.
    value: "<%= api_key %>"
    pattern: "^[a-zA-Z0-9]{<%= key_len %>,}$"
    html_options:
      class: "font-monospace"
