---
batch_connect:
  template: "basic"
  conn_params:
    - "output_log"
script:
  wall_time: <%= num_hours.to_i * 3600 %>
  native:
    - "--mem=<%= ram %>"
    - "--nodes=1"
    - "--ntasks=1"
    - "--cpus-per-task=<%= n_cpu %>"
    - "--partition=<%= partition %>"
    # <% if n_gpu.to_i > 0 %>
    - "--gres=gpu:<%= n_gpu %>"
    # <% end %>
    # <% if constraint.present? %>
    - "--constraint=<%= constraint %>"
    # <% end %>
